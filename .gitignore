# ─────────────────────────────────────────────
# CERTUS — .gitignore
# ─────────────────────────────────────────────

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─────────────── Secrets ───────────────
.env
.env.*
!.env.example

# ─────────────── Testing ───────────────
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage_*.xml
htmlcov/
_test_out.txt
test_results*.txt

# ─────────────── Linters / Type checkers ───────────────
.mypy_cache/
.pyre/
.ruff_cache/

# ─────────────── IDE / Editor ───────────────
.vscode/
.idea/
*.swp
*.swo

# ─────────────── OS files ───────────────
.DS_Store
Thumbs.db
~$*

# ─────────────── Cloud sync (Google Drive / OneDrive) ───────────────
desktop.ini
Desktop.ini

# ─────────────── Profiling ───────────────
*.prof

# ─────────────── App runtime outputs ───────────────
logs/
*.log
*.jsonl
IndexSpline_Result_*.xlsx
reports/exports/

# ─────────────── Debug / scratch ───────────────
scratch/
artifacts/
bottleneck_*.txt
.benchmarks/

# ─────────────── Legacy / dead code ───────────────
_DEAD_SCRIPTS_BACKUP/

# ─────────────── Build / release ───────────────
artifacts/root_cleanup_*/
reports/release_dossier_*.zip
_metal_cache/

# ─────────────── Local backups / test outputs ───────────────
OLD VERSION/
3105 VERSION OLD OK/
reports/Report_*
reports/STRAT_observability_*

# ─────────────── Rust engine (build artefacts) ───────────────
certus_engine_rs/target/
certus_engine_rs/uv.lock

# ─────────────── Agent / tooling worktrees ───────────────
.claude/
.numba_cache/
.vs/

# ─────────────── Archived snapshots ───────────────
archive_numba_version/

# ─────────────── Generated test / CI artefacts ───────────────
MagicMock/
benchmark_results.json
wildcard_imports_report.txt
pyflakes_output.txt
live_output*.txt
test_*.txt
_pytest_nodeids*.txt
diff_re.txt
ruff_errors.txt
translation_cache.json

# --- Residus de sessions, a la racine. Non supprimes : ils appartiennent a
# l'utilisateur et git ne pourrait pas les restaurer. Ignores pour qu'ils ne
# soient pas committes par accident, ce qui est le seul risque reel.
/extract_comments.py
/extract_pipeline.py
/extract_ui.py
/find_french.py
/replace_comments.py
/scratch_append*.py
/all_comments*.txt
/index_comments.txt
/strat_pipeline_comments.txt
/french_lines.txt
/.strat_diff.txt
/python-*-amd64.exe
/Claude Setup*.exe

# --- Le depot pousse vers un remote PUBLIC. Rien qui porte une donnee
# personnelle ou l'oeuvre d'un tiers ne doit pouvoir y entrer par accident.
# Texte integral d'une these tierce (HAL tel-04072733), 353 000 caracteres,
# nommant cinq personnes : sorti du suivi le 2026-08-14. Citer la reference
# publiee, ne pas redistribuer le texte.
reports/_zideluns_text.json

# --- SORTIES, sorties du suivi le 2026-08-15. Elles restent sur le disque et
# dans l'historique git ; elles ne sont simplement plus publiees.
#
# RAPPORT_GEMINI.md : destination d'un executant (cf. la regle des deux
# documents). Son CHEMIN reste cite par CLAUDE.md et GEMINI_TODO.md et reste
# valide -- c'est son contenu, 18 737 lignes de traces d'exception et le plus
# gros fichier suivi du depot, qui n'avait aucune valeur de reference.
reports/RAPPORT_GEMINI.md
# CAMPAGNE_{E,F,G} : sorties de run_campaign.py, remplacees par
# CAMPAGNE_RESUME.md. ⚠️ Trois de leurs valeurs sont citees dans CLAUDE.md :
# elles restent verifiables sur le disque et dans l'historique.
reports/CAMPAGNE_E_RESUME.md
reports/CAMPAGNE_F_RESUME.md
reports/CAMPAGNE_G_RESUME.md
