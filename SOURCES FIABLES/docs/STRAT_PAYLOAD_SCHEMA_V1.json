{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certus.local/strat/payload-schema-v1.json",
  "title": "CERTUS STRAT Payload Schema V1 (proposal)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "strategy": {
      "type": "object",
      "required": ["strategy_id", "origin", "n_blocks", "blocks"],
      "additionalProperties": true,
      "properties": {
        "strategy_id": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "origin": { "type": "string", "minLength": 1 },
        "n_blocks": { "type": "integer", "minimum": 1 },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["start", "end", "num_layers", "wavelength"],
            "additionalProperties": true,
            "properties": {
              "start": { "type": "integer", "minimum": 0 },
              "end": { "type": "integer", "minimum": 1 },
              "num_layers": { "type": "integer", "minimum": 1 },
              "wavelength": { "type": "number" }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "strategy_id",
        "strategy",
        "results_per_noise",
        "robustness_score",
        "num_unique_wavelengths"
      ],
      "additionalProperties": true,
      "properties": {
        "strategy_id": {
          "oneOf": [
            { "type": "integer" },
            { "type": "string", "minLength": 1 }
          ]
        },
        "strategy": { "type": "object" },
        "robustness_score": { "type": "number" },
        "num_unique_wavelengths": { "type": "integer", "minimum": 1 },
        "results_per_noise": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["noise_level", "rmse_mean", "rmse_p95", "rmse_p99"],
            "additionalProperties": true,
            "properties": {
              "noise_level": { "type": "number" },
              "rmse_mean": { "type": "number" },
              "rmse_p95": { "type": "number" },
              "rmse_p99": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "required": ["strategy", "result"]
}
