# ─────────────────────────────────────────────
# CERTUS — .gitignore
# ─────────────────────────────────────────────

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/
*.whl
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─────────────── Secrets ───────────────
.env
.env.*
!.env.example

# ─────────────── Testing ───────────────
.pytest_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
coverage_*.xml
htmlcov/
_test_out.txt
test_results*.txt

# ─────────────── Linters / Type checkers ───────────────
.mypy_cache/
.pyre/
.ruff_cache/

# ─────────────── IDE / Editor ───────────────
.vscode/
.idea/
*.swp
*.swo

# ─────────────── OS files ───────────────
.DS_Store
Thumbs.db
~$*

# ─────────────── Cloud sync (Google Drive / OneDrive) ───────────────
desktop.ini
Desktop.ini

# ─────────────── Profiling ───────────────
*.prof

# ─────────────── App runtime outputs ───────────────
logs/
*.log
*.jsonl
IndexSpline_Result_*.xlsx
reports/exports/

# ─────────────── User preferences ───────────────
# Rewritten by the application at every setting (theme, font, auto-export): they belong
# to one user, not to the repository. Missing, the code falls back to its defaults.
/certus_export.json
/certus_theme.json

# ─────────────── Stray outputs at the root ───────────────
# Written by tests or tools run from the repository root; never versioned again.
/metal_results.xlsx
/test_log
/test_cfg*.json
/test_err_save.json
/invalid_dir/
/best_headless_stack.json
/best_pglobal_metal_params*.json

# ─────────────── Debug / scratch ───────────────
scratch/
artifacts/
bottleneck_*.txt
.benchmarks/
.ast_analyzer_cache.json

# ─────────────── Build / release ───────────────
_metal_cache/

# ─────────────── Run outputs in reports/ ───────────────
# Campaign reports and per-run STRAT diagnostics are regenerated: ignored.
reports/Report_*
reports/Pareto_Summary_*
reports/STRAT_observability_*
# 🔴 EXCEPT index and metal reports: REAL spectrophotometer measurements, irrecoverable
# (CLAUDE.md, prohibition 3).
!reports/Report_INDEX*
!reports/Report_METAL*
!reports/Report_SINGLE*
# ...sauf les sorties de l'exemple SIMULE de METAL SINGLE : son nom dit qu'il n'est pas une
# mesure, et chaque optimisation de l'exemple en ecrit une (export automatique actif par
# defaut). Les 24 deja suivis le restent -- une regle d'ignore ne touche pas au passe.
reports/Report_SINGLE_Target_Titane_Simu_*

# ─────────────── Agent / tooling worktrees ───────────────
.claude/
.numba_cache/
.vs/

# ─────────────── Generated test / CI artefacts ───────────────
MagicMock/
benchmark_results.json
wildcard_imports_report.txt
pyflakes_output.txt
live_output*.txt
test_*.txt
_pytest_nodeids*.txt
diff_re.txt
ruff_errors.txt
translation_cache.json

# --- 🔴 CE QUI NE DOIT JAMAIS ENTRER DANS UN DEPOT PUBLIC. Ces deux regles ne sont pas
# du rangement : le depot est public, et l'interdit du document de reference porte sur
# l'oeuvre d'un tiers autant que sur les donnees personnelles.
#   - l'article Applied Optics sur le selenium est l'oeuvre d'un TIERS : le redistribuer
#     depend de sa licence, ce qui ne se decide pas dans un `git add -A` distrait ;
#   - `studies/` est un travail de recherche NON PUBLIE de l'utilisateur, a commiter
#     quand il le decidera. 📌 Il n'est donc dans aucun clone : le sauvegarder a la main
#     avant tout changement de machine (docs/ETAT.md).
/Selenium_Optical_Constants*.pdf
/studies/
/python-*-amd64.exe
/Claude Setup*.exe

# --- Le depot pousse vers un remote PUBLIC. Rien qui porte une donnee
# personnelle ou l'oeuvre d'un tiers ne doit pouvoir y entrer par accident.
# Texte integral d'une these tierce (HAL tel-04072733), 353 000 caracteres,
# nommant cinq personnes : sorti du suivi le 2026-08-14. Citer la reference
# publiee, ne pas redistribuer le texte.
reports/_zideluns_text.json

# --- Outputs taken out of the index on 2026-08-15 (still in the git history): an
# agent's exception log of 18 737 lines, and three campaign summaries replaced by
# CAMPAGNE_RESUME.md.
reports/RAPPORT_GEMINI.md
reports/CAMPAGNE_E_RESUME.md
reports/CAMPAGNE_F_RESUME.md
reports/CAMPAGNE_G_RESUME.md

