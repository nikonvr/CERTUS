{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "STRAT_PAYLOAD_SCHEMA_V1",
  "description": "Schema for CERTUS_STRAT worker payload validation",
  "type": "object",
  "required": ["step", "params"],
  "additionalProperties": false,
  "$defs": {
    "material_id": {
      "description": "Material identifier (string name or positive float constant)",
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "number", "exclusiveMinimum": 0}
      ]
    },
    "wl_range": {
      "type": "array",
      "description": "[wl_min, wl_max] in nm",
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "description": "Global random seed for reproducibility"
    }
  },
  "properties": {
    "step": {
      "type": "integer",
      "enum": [0, 2, 3, 23, 33],
      "description": "Computation step to execute"
    },
    "params": {
      "type": "object",
      "required": ["l0", "stack_string", "wl_range", "nH_id", "nL_id", "nSub_id"],
      "additionalProperties": false,
      "properties": {
        "l0": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Reference wavelength (nm)"
        },
        "stack_string": {
          "type": "string",
          "minLength": 1,
          "description": "Comma-separated QWOT multipliers"
        },
        "wl_range": {
          "$ref": "#/$defs/wl_range"
        },
        "nH_id": {
          "$ref": "#/$defs/material_id",
          "description": "High-index material identifier"
        },
        "nL_id": {
          "$ref": "#/$defs/material_id",
          "description": "Low-index material identifier"
        },
        "nSub_id": {
          "$ref": "#/$defs/material_id",
          "description": "Substrate material identifier"
        },
        "wl_step": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Wavelength step for spectral calculation (nm)"
        },
        "scan_wl_min": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Minimum monitoring scan wavelength (nm)"
        },
        "scan_wl_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Maximum monitoring scan wavelength (nm)"
        },
        "dynamics_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum delta-T required for a candidate (fraction)"
        },
        "min_transmission_floor": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Minimum T allowed during layer growth (fraction)"
        },
        "robustness_seed": {
          "$ref": "#/$defs/seed"
        }
      },
      "allOf": [
        {
          "if": {"required": ["scan_wl_min"]},
          "then": {"required": ["scan_wl_max"]}
        },
        {
          "if": {"required": ["scan_wl_max"]},
          "then": {"required": ["scan_wl_min"]}
        }
      ]
    },
    "opti_results": {
      "description": "Previous optimization results (optional)",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false
        },
        {"type": "null"}
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "step": {"enum": [23, 33]}
        }
      },
      "then": {
        "required": ["opti_results"],
        "properties": {
          "opti_results": {
            "type": "object",
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
